[user]
	name = ian.mcbee

[include]
  path = ~/.gitconfig-local

[init]
  defaultBranch = develop

[color]
  branch = auto
  interactive = auto
  ui = true
  pager = true

[diff]
  tool = kitty
  guitool = kitty.gui

[difftool]
  prompt = false
  trustExitCode = true

[difftool "kitty"]
  cmd = kitten diff $LOCAL $REMOTE

[difftool "kitty.gui"]
  cmd = kitten diff $LOCAL $REMOTE

[merge]
    conflictstyle = zdiff3

[push]
  default = current

[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  ll = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  l = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
  main = !git checkout main && git pull origin main
  develop = !git checkout develop && git pull origin develop 
  rp = rev-parse --abbrev-ref HEAD
  ta = tag -a -m
  unstage = reset --soft HEAD^
